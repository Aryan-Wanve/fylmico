generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  name                    String
  username                String?   @unique
  avatarUrl               String?   @map("avatar_url")
  notificationPreferences Json?     @map("notification_preferences")
  emailVerifiedAt         DateTime? @map("email_verified_at")
  activeOrganizationId    String?   @map("active_organization_id")
  lastSeenAt              DateTime? @map("last_seen_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  authAccounts              AuthAccount[]
  sessions                  Session[]
  emailVerificationTokens   EmailVerificationToken[]
  passwordResetTokens       PasswordResetToken[]
  organizationMemberships   OrganizationMembership[]
  createdTasks              Task[]                   @relation("TasksCreated")
  taskAssignments           TaskAssignee[]
  taskActivity              TaskActivity[]
  taskTimeEntries           TaskTimeEntry[]
  messages                  Message[]
  notifications             Notification[]
  comments                  Comment[]
  crewProfiles              CrewProfile[]
  calendarEvents            CalendarEvent[]
  timeEntries               TimeEntry[]
  sentInvitations           HouseInvitation[]        @relation("InvitationsSent")
  acceptedInvitations       HouseInvitation[]        @relation("InvitationsAccepted")
  houseJoinRequestsSent     HouseJoinRequest[]       @relation("JoinRequestsSent")
  houseJoinRequestsHandled  HouseJoinRequest[]       @relation("JoinRequestsHandled")
  bookings                  Booking[]
  uploadedFiles             FileEntry[]
  connectedDriveConnections DriveConnection[]
  scripts                   Script[]
  messageReactions          MessageReaction[]
  callSheets                CallSheet[]
  announcements             Announcement[]
  conversationReads         ConversationRead[]

  @@map("users")
}

model Organization {
  id             String   @id @default(cuid())
  name           String
  handle         String   @unique
  description    String
  inviteCode     String   @unique @map("invite_code")
  type           String   @default("custom")
  enabledModules String[] @default([]) @map("enabled_modules")
  bannedUserIds  String[] @default([]) @map("banned_user_ids")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  roles           Role[]
  memberships     OrganizationMembership[]
  tasks           Task[]
  conversations   Conversation[]
  projects        Project[]
  clients         Client[]
  comments        Comment[]
  crewProfiles    CrewProfile[]
  calendarEvents  CalendarEvent[]
  timeEntries     TimeEntry[]
  invitations     HouseInvitation[]
  joinRequests    HouseJoinRequest[]
  resources       Resource[]
  bookings        Booking[]
  boards          Board[]
  fileEntries     FileEntry[]
  characters      Character[]
  storyLocations  StoryLocation[]
  scripts         Script[]
  callSheets      CallSheet[]
  announcements   Announcement[]
  notifications   Notification[]
  driveConnection DriveConnection?

  @@map("organizations")
}

model Role {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  color          String
  description    String
  permissions    String[] @default([])
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  OrganizationMembership[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model OrganizationMembership {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  roleId         String?   @map("role_id")
  order          Int       @default(0)
  favoritedAt    DateTime? @map("favorited_at")
  pinnedAt       DateTime? @map("pinned_at")
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role?        @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_memberships")
}

model HouseInvitation {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  email          String
  tokenHash      String    @unique @map("token_hash")
  invitedById    String    @map("invited_by_id")
  status         String    @default("pending")
  expiresAt      DateTime  @map("expires_at")
  acceptedById   String?   @map("accepted_by_id")
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationsSent", fields: [invitedById], references: [id])
  acceptedBy   User?        @relation("InvitationsAccepted", fields: [acceptedById], references: [id])

  @@index([organizationId])
  @@index([email])
  @@map("house_invitations")
}

model HouseJoinRequest {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  status         String    @default("pending")
  respondedById  String?   @map("responded_by_id")
  respondedAt    DateTime? @map("responded_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("JoinRequestsSent", fields: [userId], references: [id], onDelete: Cascade)
  respondedBy  User?        @relation("JoinRequestsHandled", fields: [respondedById], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("house_join_requests")
}

model AuthAccount {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  passwordHash      String?  @map("password_hash")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Session {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @map("token_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @map("token_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Task {
  id                String    @id @default(cuid())
  organizationId    String    @map("organization_id")
  conversationId    String?   @map("conversation_id")
  parentTaskId      String?   @map("parent_task_id")
  projectId         String?   @map("project_id")
  boardId           String?   @map("board_id")
  scriptId          String?   @map("script_id")
  shootDayEventId   String?   @map("shoot_day_event_id")
  createdById       String    @map("created_by_id")
  title             String
  description       String?
  type              String    @default("custom")
  status            String    @default("todo")
  priority          String    @default("medium")
  dueDate           DateTime? @map("due_date")
  startDate         DateTime? @map("start_date")
  estimatedMinutes  Int?      @map("estimated_minutes")
  recurrenceRule    String?   @map("recurrence_rule")
  recurrenceEndDate DateTime? @map("recurrence_end_date")
  equipment         String[]
  location          String?
  callTime          String?   @map("call_time")
  deliverables      String[]
  tags              String[]
  progress          Int       @default(0)
  isTemplate        Boolean   @default(false) @map("is_template")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation   Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  parent         Task?               @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks       Task[]              @relation("TaskSubtasks")
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  board          Board?              @relation(fields: [boardId], references: [id], onDelete: SetNull)
  script         Script?             @relation(fields: [scriptId], references: [id], onDelete: SetNull)
  shootDayEvent  CalendarEvent?      @relation(fields: [shootDayEventId], references: [id], onDelete: SetNull)
  createdBy      User                @relation("TasksCreated", fields: [createdById], references: [id])
  assignees      TaskAssignee[]
  checklistItems TaskChecklistItem[]
  activity       TaskActivity[]
  timeEntries    TaskTimeEntry[]
  attachments    FileEntry[]
  blockingOf     TaskDependency[]    @relation("BlockingTask")
  blockedBy      TaskDependency[]    @relation("BlockedTask")

  @@index([organizationId])
  @@index([conversationId])
  @@index([parentTaskId])
  @@index([projectId])
  @@index([boardId])
  @@index([scriptId])
  @@index([shootDayEventId])
  @@index([createdById])
  @@map("tasks")
}

model TaskAssignee {
  id             String   @id @default(cuid())
  taskId         String   @map("task_id")
  userId         String   @map("user_id")
  responsibility String?
  createdAt      DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

model TaskChecklistItem {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  text      String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_checklist_items")
}

model TaskDependency {
  id             String   @id @default(cuid())
  blockingTaskId String   @map("blocking_task_id")
  blockedTaskId  String   @map("blocked_task_id")
  createdAt      DateTime @default(now()) @map("created_at")

  blockingTask Task @relation("BlockingTask", fields: [blockingTaskId], references: [id], onDelete: Cascade)
  blockedTask  Task @relation("BlockedTask", fields: [blockedTaskId], references: [id], onDelete: Cascade)

  @@unique([blockingTaskId, blockedTaskId])
  @@index([blockedTaskId])
  @@map("task_dependencies")
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  actorId   String   @map("actor_id")
  type      String
  fromValue String?  @map("from_value")
  toValue   String?  @map("to_value")
  createdAt DateTime @default(now()) @map("created_at")

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id])

  @@index([taskId])
  @@map("task_activity")
}

model TaskTimeEntry {
  id              String    @id @default(cuid())
  taskId          String    @map("task_id")
  userId          String    @map("user_id")
  startedAt       DateTime  @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationMinutes Int?      @map("duration_minutes")
  note            String?
  createdAt       DateTime  @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@map("task_time_entries")
}

model Conversation {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  topic          String
  createdAt      DateTime @default(now()) @map("created_at")

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       Message[]
  tasks          Task[]
  calendarEvents CalendarEvent[]
  fileEntries    FileEntry[]
  reads          ConversationRead[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("conversations")
}

model ConversationRead {
  id                String   @id @default(cuid())
  conversationId    String   @map("conversation_id")
  userId            String   @map("user_id")
  lastReadMessageId String?  @map("last_read_message_id")
  lastReadAt        DateTime @default(now()) @map("last_read_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_reads")
}

model Message {
  id              String    @id @default(cuid())
  conversationId  String    @map("conversation_id")
  authorId        String    @map("author_id")
  parentMessageId String?   @map("parent_message_id")
  body            String
  createdAt       DateTime  @default(now()) @map("created_at")
  editedAt        DateTime? @map("edited_at")

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User              @relation(fields: [authorId], references: [id])
  parent       Message?          @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: Cascade)
  replies      Message[]         @relation("MessageReplies")
  reactions    MessageReaction[]

  @@index([conversationId])
  @@index([authorId])
  @@index([parentMessageId])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model Project {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  type           String?
  genre          String?
  stage          String   @default("Development")
  progress       Int      @default(0)
  coverGradient  String?  @map("cover_gradient")
  coverIcon      String?  @map("cover_icon")
  dueDate        String?  @map("due_date")
  teamIds        String[] @map("team_ids")
  priority       String   @default("medium")
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clients        ProjectClient[]
  calendarEvents CalendarEvent[]
  timeEntries    TimeEntry[]
  bookings       Booking[]
  boards         Board[]
  characters     Character[]
  storyLocations StoryLocation[]
  scripts        Script[]
  callSheets     CallSheet[]
  tasks          Task[]

  @@index([organizationId])
  @@map("projects")
}

model Client {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  logoUrl        String?  @map("logo_url")
  contactName    String?  @map("contact_name")
  contactEmail   String?  @map("contact_email")
  phone          String?
  address        String?
  gst            String?
  notes          String?
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     ProjectClient[]

  @@index([organizationId])
  @@map("clients")
}

model ProjectClient {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  clientId  String   @map("client_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([projectId, clientId])
  @@index([projectId])
  @@index([clientId])
  @@map("project_clients")
}

model Notification {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  organizationId String?   @map("organization_id")
  type           String
  title          String
  body           String
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("notifications")
}

model Comment {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  commentableType String   @map("commentable_type")
  commentableId   String   @map("commentable_id")
  authorId        String   @map("author_id")
  body            String
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])

  @@index([organizationId])
  @@index([commentableType, commentableId])
  @@map("comments")
}

model CrewProfile {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  jobTitle       String   @map("job_title")
  department     String   @default("Production")
  roleCategory   String   @default("Other") @map("role_category")
  status         String   @default("available")
  currentProject String?  @map("current_project")
  projectStage   String?  @map("project_stage")
  availability   String?
  birthday       String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@map("crew_profiles")
}

model CalendarEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  projectId      String?  @map("project_id")
  conversationId String?  @map("conversation_id")
  createdById    String   @map("created_by_id")
  title          String
  date           String
  time           String
  location       String?
  category       String   @default("other")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdBy    User          @relation(fields: [createdById], references: [id])
  tasks        Task[]

  @@index([organizationId])
  @@index([projectId])
  @@index([conversationId])
  @@map("calendar_events")
}

model TimeEntry {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  projectId      String?  @map("project_id")
  userId         String   @map("user_id")
  phase          String   @default("Production")
  hours          Float
  date           String
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([projectId])
  @@index([userId])
  @@map("time_entries")
}

model Resource {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  category       String   @default("equipment")
  subtitle       String?
  tag            String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings     Booking[]

  @@index([organizationId])
  @@map("resources")
}

model Booking {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  resourceId     String   @map("resource_id")
  projectId      String?  @map("project_id")
  startDate      String   @map("start_date")
  endDate        String   @map("end_date")
  startTime      String   @map("start_time")
  endTime        String   @map("end_time")
  status         String   @default("confirmed")
  bookedById     String   @map("booked_by_id")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resource     Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  bookedBy     User         @relation(fields: [bookedById], references: [id])

  @@index([organizationId])
  @@index([resourceId])
  @@index([projectId])
  @@map("bookings")
}

model Board {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  projectId      String?  @map("project_id")
  scriptId       String?  @map("script_id")
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  script       Script?      @relation(fields: [scriptId], references: [id], onDelete: SetNull)
  shots        Shot[]
  tasks        Task[]

  @@index([organizationId])
  @@index([projectId])
  @@index([scriptId])
  @@map("boards")
}

model Shot {
  id          String   @id @default(cuid())
  boardId     String   @map("board_id")
  order       Int      @default(0)
  description String
  cameraAngle String?  @map("camera_angle")
  notes       String?
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
  @@map("shots")
}

model Character {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  projectId      String?  @map("project_id")
  name           String
  role           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([projectId])
  @@map("characters")
}

model StoryLocation {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  projectId      String?  @map("project_id")
  name           String
  type           String
  shotCount      Int      @default(0) @map("shot_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([projectId])
  @@map("story_locations")
}

model Script {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  projectId      String?  @map("project_id")
  title          String
  content        String   @default("")
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy    User         @relation(fields: [createdById], references: [id])
  boards       Board[]
  tasks        Task[]

  @@index([organizationId])
  @@index([projectId])
  @@map("scripts")
}

model FileEntry {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  parentId       String?  @map("parent_id")
  conversationId String?  @map("conversation_id")
  taskId         String?  @map("task_id")
  name           String
  type           String
  storagePath    String?  @map("storage_path")
  driveKey       String?  @map("drive_key")
  sensitive      Boolean  @default(false)
  size           Int?
  mimeType       String?  @map("mime_type")
  uploadedById   String   @map("uploaded_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       FileEntry?    @relation("FileEntryChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     FileEntry[]   @relation("FileEntryChildren")
  uploadedBy   User          @relation(fields: [uploadedById], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  task         Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([organizationId, driveKey])
  @@index([organizationId])
  @@index([parentId])
  @@index([conversationId])
  @@index([taskId])
  @@map("file_entries")
}

// One shared Google Drive connection per house, connected by the Owner -
// see ADR 0045 (supersedes ADR 0038's per-user design). Fylmico auto-manages
// the folder tree under the two root folders below.
model DriveConnection {
  id                    String   @id @default(cuid())
  organizationId        String   @unique @map("organization_id")
  connectedById         String   @map("connected_by_id")
  refreshToken          String   @map("refresh_token")
  googleEmail           String?  @map("google_email")
  visibleRootFolderId   String   @map("visible_root_folder_id")
  sensitiveRootFolderId String   @map("sensitive_root_folder_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy  User         @relation(fields: [connectedById], references: [id])

  @@map("drive_connections")
}

model CallSheet {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  projectId       String?  @map("project_id")
  title           String
  shootDate       String   @map("shoot_date")
  generalCallTime String   @map("general_call_time")
  location        String?
  weather         String?
  notes           String?
  crewCallTimes   Json     @map("crew_call_times")
  createdById     String   @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([projectId])
  @@map("call_sheets")
}

model Announcement {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  authorId       String   @map("author_id")
  title          String
  body           String
  pinned         Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])

  @@index([organizationId])
  @@map("announcements")
}
