generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String
  emailVerifiedAt      DateTime? @map("email_verified_at")
  activeOrganizationId String?   @map("active_organization_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  authAccounts            AuthAccount[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  organizationMemberships OrganizationMembership[]
  assignedTasks           Task[]
  messages                Message[]
  notifications           Notification[]
  comments                Comment[]
  crewProfiles            CrewProfile[]
  calendarEvents          CalendarEvent[]
  timeEntries             TimeEntry[]
  sentInvitations         HouseInvitation[] @relation("InvitationsSent")
  acceptedInvitations     HouseInvitation[] @relation("InvitationsAccepted")

  @@map("users")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  handle      String   @unique
  description String
  inviteCode  String   @unique @map("invite_code")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles         Role[]
  memberships   OrganizationMembership[]
  tasks         Task[]
  conversations Conversation[]
  projects      Project[]
  clients       Client[]
  comments       Comment[]
  crewProfiles   CrewProfile[]
  calendarEvents CalendarEvent[]
  timeEntries    TimeEntry[]
  invitations    HouseInvitation[]

  @@map("organizations")
}

model Role {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  color          String
  description    String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  OrganizationMembership[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model OrganizationMembership {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  roleId         String   @map("role_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_memberships")
}

model HouseInvitation {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  email          String
  tokenHash      String    @unique @map("token_hash")
  invitedById    String    @map("invited_by_id")
  status         String    @default("pending")
  expiresAt      DateTime  @map("expires_at")
  acceptedById   String?   @map("accepted_by_id")
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationsSent", fields: [invitedById], references: [id])
  acceptedBy   User?        @relation("InvitationsAccepted", fields: [acceptedById], references: [id])

  @@index([organizationId])
  @@index([email])
  @@map("house_invitations")
}

model AuthAccount {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  passwordHash      String?  @map("password_hash")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Session {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Task {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  title          String
  project        String
  assigneeId     String   @map("assignee_id")
  role           String
  dueDate        String   @map("due_date")
  status         String   @default("todo")
  priority       String   @default("medium")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User         @relation(fields: [assigneeId], references: [id])

  @@index([organizationId])
  @@index([assigneeId])
  @@map("tasks")
}

model Conversation {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  topic          String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  authorId       String   @map("author_id")
  body           String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])

  @@index([conversationId])
  @@index([authorId])
  @@map("messages")
}

model Project {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  type           String?
  genre          String?
  stage          String   @default("Development")
  progress       Int      @default(0)
  coverGradient  String?  @map("cover_gradient")
  coverIcon      String?  @map("cover_icon")
  dueDate        String?  @map("due_date")
  teamIds        String[] @map("team_ids")
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clients        ProjectClient[]
  calendarEvents CalendarEvent[]
  timeEntries    TimeEntry[]

  @@index([organizationId])
  @@map("projects")
}

model Client {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  contactName    String?  @map("contact_name")
  contactEmail   String?  @map("contact_email")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     ProjectClient[]

  @@index([organizationId])
  @@map("clients")
}

model ProjectClient {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  clientId  String   @map("client_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([projectId, clientId])
  @@index([projectId])
  @@index([clientId])
  @@map("project_clients")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String
  title     String
  body      String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model Comment {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  commentableType String   @map("commentable_type")
  commentableId   String   @map("commentable_id")
  authorId        String   @map("author_id")
  body            String
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])

  @@index([organizationId])
  @@index([commentableType, commentableId])
  @@map("comments")
}

model CrewProfile {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  jobTitle       String   @map("job_title")
  department     String   @default("Production")
  roleCategory   String   @default("Other") @map("role_category")
  status         String   @default("available")
  currentProject String?  @map("current_project")
  projectStage   String?  @map("project_stage")
  availability   String?
  birthday       String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@map("crew_profiles")
}

model CalendarEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  projectId      String?  @map("project_id")
  createdById    String   @map("created_by_id")
  title          String
  date           String
  time           String
  location       String?
  category       String   @default("other")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([projectId])
  @@map("calendar_events")
}

model TimeEntry {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  projectId      String?  @map("project_id")
  userId         String   @map("user_id")
  phase          String   @default("Production")
  hours          Float
  date           String
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([projectId])
  @@index([userId])
  @@map("time_entries")
}
