NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_NAME=Fylmico
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (packages/database) - the backend now lives inside apps/web as
# Next.js Route Handlers under src/app/api/v1, not a separate service, so
# there's no separate API port or CORS origin to configure anymore.
DATABASE_URL=postgresql://fylmico:fylmico@localhost:5432/fylmico?schema=public

# Auth (apps/web/src/server/auth) - refresh/verification/reset tokens are
# opaque random values hashed server-side, not JWTs, so only the access
# token needs a signing secret.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Google OAuth (apps/web/src/server/auth) - from the Google Cloud Console
# OAuth client used for "Continue with Google" sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
