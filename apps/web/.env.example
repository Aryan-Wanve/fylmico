NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_NAME=Fylmico
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (packages/database)
DATABASE_URL=postgresql://fylmico:fylmico@localhost:5432/fylmico?schema=public

# Auth (src/server/auth) - refresh/verification/reset tokens are opaque
# random values hashed server-side, not JWTs, so only the access token needs
# a signing secret.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Client review session cookie (src/server/review-sessions) - signs the
# short-lived "this browser verified OTP" cookie issued to a client review
# link visitor, kept separate from JWT_ACCESS_SECRET.
REVIEW_SESSION_COOKIE_SECRET=

# Google OAuth (src/server/auth) - from the Google Cloud Console OAuth
# client used for "Continue with Google" sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Google Maps Embed API (components/tasks/cards/shoot-task-card.tsx) -
# optional. When set, the Shoot task card shows an embedded map preview of
# the shoot location; when unset, it falls back to a plain "open in Google
# Maps" link. Needs the Maps Embed API enabled on the same Cloud project.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Experimental, production-only tuning - see docs/hostinger-deployment.md's
# "Max Processes" section. Prisma's query engine is a Rust binary running a
# tokio async runtime, which by default sizes its worker-thread pool off
# the detected CPU count; on shared/containerized hosting that count is
# often wildly over-reported (same root cause as the connection_limit cap
# in server/prisma.ts), and each of those threads counts against the
# host's process/thread ceiling. Not documented as officially supported by
# Prisma - this is an unverified attempt to cap it via the underlying
# tokio runtime, safe to leave unset (Prisma falls back to its own
# default) or remove if it turns out to have no effect.
TOKIO_WORKER_THREADS=2
