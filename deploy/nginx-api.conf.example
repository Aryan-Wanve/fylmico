# Copy to /etc/nginx/sites-available/fylmico-api on the VPS, symlink into
# sites-enabled, replace api.example.com with your real API subdomain, then
# run `certbot --nginx -d api.example.com` to fill in the SSL block.
server {
    listen 80;
    server_name api.example.com;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
