# Copy this file to /opt/fylmico/.env on the VPS (same directory as
# docker-compose.prod.yml) and fill in real values. This file is never
# committed to git - it lives only on the server.

# A long random password for the Postgres container. Generate with:
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# A long random signing secret for access tokens. Generate with:
#   openssl rand -hex 64
JWT_ACCESS_SECRET=

# The origin(s) allowed to call the API - your Hostinger static site's
# real domain, e.g. https://fylmico.com (no trailing slash).
CORS_ORIGIN=

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
